{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Idea research",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "one_liner",
    "target_customer",
    "existing_products",
    "demand_signals",
    "market",
    "monetisation",
    "build",
    "usage_frequency",
    "distribution_channels",
    "differentiation_angles",
    "why_now",
    "kill_risks",
    "recent_moves",
    "scores",
    "confidence",
    "confidence_rationale",
    "sources",
    "calibration_notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "one_liner": {
      "type": "string",
      "minLength": 1
    },
    "target_customer": {
      "type": "string",
      "minLength": 1
    },
    "existing_products": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url",
          "pricing",
          "positioning",
          "strengths",
          "weaknesses",
          "traction_signal",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "pricing": {
            "type": "string"
          },
          "positioning": {
            "type": "string"
          },
          "strengths": {
            "type": "string"
          },
          "weaknesses": {
            "type": "string"
          },
          "traction_signal": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "direct",
              "indirect",
              "substitute"
            ]
          }
        }
      }
    },
    "demand_signals": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_estimate",
        "sizing_method",
        "growth",
        "is_own_estimate"
      ],
      "properties": {
        "size_estimate": {
          "type": "string"
        },
        "sizing_method": {
          "type": "string"
        },
        "growth": {
          "type": "string"
        },
        "is_own_estimate": {
          "type": "boolean"
        }
      }
    },
    "monetisation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payer",
        "model",
        "price_point",
        "comparable_pricing",
        "acquisition_and_serving_costs"
      ],
      "properties": {
        "payer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "price_point": {
          "type": "string"
        },
        "comparable_pricing": {
          "type": "string"
        },
        "acquisition_and_serving_costs": {
          "type": "string"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mvp_scope",
        "effort_estimate",
        "dependencies"
      ],
      "properties": {
        "mvp_scope": {
          "type": "string"
        },
        "effort_estimate": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "access_risk"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "access_risk": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          }
        }
      }
    },
    "usage_frequency": {
      "type": "string",
      "minLength": 1
    },
    "distribution_channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "differentiation_angles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "why_now": {
      "type": "string",
      "minLength": 1
    },
    "kill_risks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "recent_moves": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_severity",
        "market_size",
        "competition",
        "differentiation",
        "monetisation",
        "retention",
        "feasibility",
        "distribution",
        "founder_fit",
        "timing_and_risk"
      ],
      "patternProperties": {
        "^[a-z_]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "evidence",
            "rationale"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "evidence": {
              "type": "string",
              "enum": [
                "strong",
                "moderate",
                "weak"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 20
            }
          }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "confidence_rationale": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url",
          "used_for"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "used_for": {
            "type": "string"
          }
        }
      }
    },
    "calibration_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
